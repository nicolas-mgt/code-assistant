{
  "config-version": 8,
  "server": {"host": "", "port": 8317},
  "management": {"allow-remote": false, "secret-key": "", "disable-control-panel": true},
  "access": {"api-keys": []},
  "oauth": {"auth-dir": "/data/auth"},
  "routing": {
    "cooldown": {"disable-cooling": true},
    "retry": {"request-retry": 0}
  },
  "requests": {
    "streaming": {"keepalive-seconds": 15, "send-keepalive-before-ft": true},
    "payload": {
      "override": [
        {
          "models": [
            {
              "name": "gpt-6-astra",
              "protocol": "codex",
              "match": [{"reasoning.effort": "none"}]
            }
          ],
          "params": {"reasoning.effort": "low"}
        }
      ]
    }
  },
  "observability": {
    "logs": {"debug": false, "logging-to-file": false, "request-log": false, "error-logs-max-files": 1},
    "usage": {"usage-statistics-enabled": false}
  }
}
